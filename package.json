{
    "name": "tucatv",
    "version": "0.13.0",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "preview": "vite preview",
        "format": "npm run format:prettier && npm run format:python",
        "format:prettier": "prettier --write . --ignore-unknown",
        "format:python": "python -m black desktop scripts",
        "format:check": "prettier --check . --ignore-unknown && python -m black --check desktop scripts",
        "test": "node --test tests/*.test.js",
        "android:sync": "npm run build && cap sync android",
        "android:release": "python scripts/build_android.py",
        "desktop:prepare": "npm run build && python scripts/prepare_desktop.py",
        "test:ui": "playwright test"
    },
    "dependencies": {
        "@capacitor/android": "^6.2.3",
        "@capacitor/cli": "^6.2.3",
        "@capacitor/core": "^6.2.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.0.0",
        "hls.js": "^1.6.0",
        "idb-keyval": "^6.3.0",
        "saxes": "^6.0.0",
        "svelte": "^5.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^6.0.0",
        "xz-decompress": "^0.2.3"
    },
    "private": true,
    "license": "UNLICENSED",
    "author": {
        "name": "Stefano Di Pasquale",
        "email": "stefaniscion@gmail.com"
    },
    "engines": {
        "node": ">=22 <25"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@prettier/plugin-xml": "^3.4.2",
        "prettier": "^3.9.10",
        "prettier-plugin-java": "^2.11.0",
        "prettier-plugin-sh": "^0.20.2",
        "prettier-plugin-svelte": "^4.1.1"
    }
}
